<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherApp" xmlns:viewmodels="clr-namespace:WeatherApp.ViewModels" xmlns:views="clr-namespace:WeatherApp.Views"
        mc:Ignorable="d"
        Title="Weather App" Height="680" Width="850"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/weatherapp.ico">
    <ContentControl Content="{Binding CurrentViewModel}">
        <ContentControl.Resources>
            <DataTemplate DataType="{x:Type viewmodels:WeatherViewModel}">
                <views:WeatherView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:FavouriteViewModel}">
                <views:FavouriteView />
            </DataTemplate>
        </ContentControl.Resources>
    </ContentControl>
</Window>
